{
  "name": "aethersketch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The architecture canvas built for humans and agents.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/logs vite",
    "build": "npm run typecheck && cross-env WRANGLER_LOG_PATH=.wrangler/logs vite build",
    "preview": "npm run build && cross-env WRANGLER_LOG_PATH=.wrangler/logs vite preview",
    "deploy": "npm run build && cross-env WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:webmcp": "vitest run evals/webmcp",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf-typegen": "cross-env WRANGLER_LOG_PATH=.wrangler/logs wrangler types"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.5",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webmcp-types": "^0.1.5",
    "wrangler": "^4.126.0"
  }
}
